import system;

struct DrawgCanvas {
    int32 width;
    int32 height;
    int64 pixels;
    int32 alive;
};

struct Gfx2D {
    struct DrawgCanvas canvas;
    int32 width;
    int32 height;
    int32 alive;
};

extern int32 gfx2d_open(struct Gfx2D*, int32, int32, string);
extern int32 gfx2d_frame(struct Gfx2D*, int32);
extern void gfx2d_close(struct Gfx2D*);

int32 main() {
    struct Gfx2D g;
    if (gfx2d_open(&g, 800, 600, "GFX2D Bootstrap") == 0) {
        system_exit(2);
        return 0;
    }

    int32 frame = 0;
    while (frame < 1200) {
        if (gfx2d_frame(&g, frame) == 0) break;
        frame = frame + 1;
    }

    gfx2d_close(&g);
    system_exit(0);
    return 0;
}
