// Backend Windows GDI para drawg.
//
// Importante: el compilador C! x86_64 emite llamadas estilo SysV.
// Windows x64 usa otra ABI para Win32, así que este backend llama a un
// puente pequeño (`backend_windows_gdi_bridge.c`) que exporta funciones
// SysV y desde C invoca Win32/GDI con la ABI correcta.

int64 drawg_win_hwnd = 0;
int64 drawg_win_hdc = 0;
int32 drawg_win_close = 0;

extern int64 gee_win_drawg_create_window(int32, int32, string);
extern int64 gee_win_drawg_get_dc(int64);
extern int32 gee_win_drawg_should_close(int64);
extern void gee_win_drawg_present(int64, int64, int64, int32, int32);
extern void gee_win_drawg_sleep(int32);
extern void gee_win_drawg_shutdown(int64, int64);
extern int64 gee_win_drawg_malloc(int64);
extern void gee_win_drawg_free(int64);

int64 drawg_heap_alloc(int64 size) {
    return gee_win_drawg_malloc(size);
}

void drawg_heap_free(int64 ptr) {
    if (ptr == 0) return;
    gee_win_drawg_free(ptr);
}

int32 drawg_backend_init(int32 width, int32 height, string title) {
    drawg_win_hwnd = gee_win_drawg_create_window(width, height, title);
    if (drawg_win_hwnd == 0) return 0;

    drawg_win_hdc = gee_win_drawg_get_dc(drawg_win_hwnd);
    if (drawg_win_hdc == 0) return 0;

    drawg_win_close = 0;
    return 1;
}

int32 drawg_backend_should_close() {
    if (drawg_win_hwnd == 0) return 1;
    drawg_win_close = gee_win_drawg_should_close(drawg_win_hwnd);
    return drawg_win_close;
}

void drawg_backend_present(int64 pixels, int32 width, int32 height) {
    if (drawg_win_hwnd == 0) return;
    if (drawg_win_hdc == 0) return;
    gee_win_drawg_present(drawg_win_hwnd, drawg_win_hdc, pixels, width, height);
}

void drawg_backend_sleep(int32 ms) {
    if (ms <= 0) return;
    gee_win_drawg_sleep(ms);
}

void drawg_backend_shutdown() {
    if (drawg_win_hwnd != 0) {
        gee_win_drawg_shutdown(drawg_win_hwnd, drawg_win_hdc);
    }
    drawg_win_hwnd = 0;
    drawg_win_hdc = 0;
    drawg_win_close = 1;
}
